<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.md.mapper.AssetsMapper">

    <select id="page" resultType="com.md.entity.Assets">
        select * from rms_assets
        <where>
            <if test="title!=null and title!=''">
                title like concat('%',#{title},'%')
                and
            </if>
            deleted=0
        </where>
    </select>
    <!--删除多条-->
    <update id="deleteBatch">
        update rms_assets set deleted=1,updated=current_timestamp where id in
        <foreach collection="list" item="e" open="(" separator="," close=")">
            #{e}
        </foreach>
    </update>

    <!--单条修改-->
    <update id="update" parameterType="com.md.entity.Assets">
        update  rms_assets set
        <if test="title!=null">title=#{title},</if>
        <if test="picture!=null">picture=#{picture},</if>
        <if test="price!=null">price=#{price},</if>
        <if test="priceUnit!=null">price_unit=#{priceUnit},</if>
        <if test="stock!=null">stock=#{stock},</if>
        <if test="stockUnit!=null">stock_unit=#{stockUnit},</if>
        <if test="total!=null">total=#{total},</if>
        <if test="info!=null">info=#{info},</if>
        <if test="updated!=null">updated=#{updated},</if>
        version=version+1
        where id =#{id} and deleted=0 and version=#{version}
    </update>
</mapper>